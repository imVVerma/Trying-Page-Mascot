# Hugging Face Access Token for FLUX.1-Kontext-dev Image-to-Image Generation
# Get a free read/write token from: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=

# AICredits API Secret Key (Cloudflare Pages Functions & backend proxy)
# Set in Cloudflare Pages dashboard settings -> Environment variables -> Production & Preview:
# AICREDITS_API_KEY=sk-...
AICREDITS_API_KEY=

# Optional local Vite client key (for local dev fallback)
VITE_AICREDITS_API_KEY=
